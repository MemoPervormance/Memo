# CroixAI — config.toml example
# Copy as config.toml next to main.py

[capture]
backend              = "dxgi"        # dxgi / winrt / capture_card / udp / ndi
monitor              = 0
capture_size         = 320
fps_limit            = 0
steady_fps           = 100
circle_mask          = false
# UDP capture (2-PC)
udp_host             = "0.0.0.0"
udp_port             = 9999
# NDI
ndi_source           = ""
# Capture card (DirectShow device name)
capture_card_source  = ""

[detection]
backend              = "dml"         # dml / trt
model_path           = "model.onnx"  # or model.engine for TRT
confidence_threshold = 0.5           # 0.10–1.0
nms_threshold        = 0.45
target_classes       = []
priority_classes     = []
use_cuda             = true
use_tensorrt         = false
max_detections       = 10
blob_size            = 320           # 160 / 320 / 640

[aim]
enabled          = true
position         = "head"            # head / body
aim_key          = "mouse5"
toggle_key       = "f6"
exit_key         = "f12"
pause_key        = "pause"
overlay_key      = "insert"
screenshot_key   = "f8"
fov_x            = 60.0             # 10–120
fov_y            = 60.0
speed            = 1.0              # 0.1–3.0
auto_aim         = false
auto_shoot       = false
snap_radius      = 22.0
near_radius      = 80.0
scope_multiplier = 1.0
head_from_top    = 0.10
aim_smoothness   = 1.0
aim_speed        = 0.001

[aim.sticky_target]
enabled         = false
hold_duration   = 1.5               # seconds
static_filter   = false

[aim.prediction]
enabled          = true
interval         = 0.0              # 0.00–0.50 s lookahead step
future_positions = 5                # 1–40
lead_factor      = 80.0
min_speed        = 30.0
max_offset       = 25.0
lead_max_jump    = 120.0

[aim.recoil]
enabled    = false
strength   = 1.0                    # 0.1–10.0
smoothness = 2.0

[aim.wind_mouse]
enabled     = false
gravity     = 9.0
wind        = 3.0
min_wait    = 2.0
max_wait    = 10.0
max_step    = 8.0
target_area = 8.0

[controller]
stick_sensitivity  = 0.75
stick_deadzone_px  = 1.0
stick_smoothing    = 0.35
stick_acceleration = 1.4
stick_y_invert     = true
stick_x_invert     = false
rs_min_magnitude   = 0.16
lt_while_aim       = false

[crosshair]
offset_x   = 0.0
offset_y   = 0.0
parallax_x = 0.0
parallax_y = 0.0

[triggerbot]
enabled            = false
trigger_key        = "mouse4"
min_confidence     = 0.65
crosshair_radius   = 8.0
min_frames         = 3
delay_ms           = 30
burst_ms           = 80
cooldown_ms        = 120
visibility_check   = true
min_pixel_variance = 15.0
sample_size        = 5

[overlay]
enabled           = false
detection_boxes   = true
box_color         = "#FF0000"
box_thickness     = 2
future_dots       = false
future_dot_color  = "#00FF00"
capture_border    = false
target_icons      = false
target_icon_path  = ""
opacity           = 0.8

[input]
# Backend: relative_mouse / virtual_gamepad / kernel_driver /
#          ghub / arduino / kmbox_net / makcu / rp2040 / rp2350 / titan_two
backend      = "relative_mouse"
serial_port  = "COM3"
serial_baud  = 115200
kmbox_ip     = "192.168.2.188"
kmbox_port   = 1408
ghub_port    = 12010
driver_path  = "\\\\.\\CroixAIDriver"

[debug]
show_fps        = false
show_detections = false
verbose         = false

[info]
discord_rpc = true
