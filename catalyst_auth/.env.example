# Catalyst Auth — Environment Variables
# Copy to .env and fill in real values

# PostgreSQL connection
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/catalyst_auth

# JWT signing key — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_to_a_long_random_string

# Token expiry (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS — comma-separated origins (* = all, not for production)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Discord webhook URL (optional)
DISCORD_WEBHOOK_URL=

# Telegram bot (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
